{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
  {% if site.quotes %}
    <div id="random-quote" class="mt-2"><em id="random-quote-text">{{ site.quotes | first | default: "" }}</em></div>
    <script>
      (function() {
        var quotes = {{ site.quotes | jsonify }};
        if (Array.isArray(quotes) && quotes.length) {
          var quote = quotes[Math.floor(Math.random() * quotes.length)];
          var target = document.getElementById('random-quote-text');
          if (target && typeof quote === 'string') {
            target.textContent = quote;
          }
        }
      })();
    </script>
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-2" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
