<div class="languages-grid">
  {% for content in data[1] %}
    <div class="language-item">
      <div class="language-item-header">
        <div>
          <div class="language-name">{{ content.language }}</div>
          <div class="language-fluency">{{ content.fluency }}</div>
        </div>
        {% if content.certificate_file %}
          <a href="{{ content.certificate_file | prepend: 'assets/pdf/' | relative_url }}" target="_blank" rel="noopener noreferrer" class="btncv">
            <i class="fa-solid fa-file-pdf"></i> Certificate
          </a>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>
